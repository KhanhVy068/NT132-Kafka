
# Kafka Broker Connection
KAFKA_BOOTSTRAP_SERVERS=192.168.56.10:9092

# Kafka Topics
TOPIC_ORDERS=orders.created
TOPIC_INVENTORY_RESULTS=inventory.results
TOPIC_INVENTORY_UPDATED=inventory.updated
TOPIC_PAYMENTS_RESULTS=payments.results

# Consumer Groups
GROUP_INVENTORY=inventory-group
GROUP_PAYMENT=payment-group
GROUP_NOTIFICATION=notification-group
GROUP_STOCK_VIEW=stock-view-group

# Consumer Configuration
AUTO_OFFSET_RESET=earliest
ENABLE_AUTO_COMMIT=false

# Database Paths
INVENTORY_DB_PATH=data/inventory.db
STOCK_VIEW_DB_PATH=data/stock_view.db
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=matkhau