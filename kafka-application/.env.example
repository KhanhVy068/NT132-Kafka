
# Kafka Broker Connection
KAFKA_BOOTSTRAP_SERVERS=192.168.56.10:9092

# Kafka Topics
TOPIC_ORDERS=orders.created
TOPIC_INVENTORY_RESULTS=inventory.results
TOPIC_INVENTORY_UPDATED=inventory.updated
TOPIC_PAYMENTS_RESULTS=payments.results

# Consumer Groups
GROUP_INVENTORY=inventory-group
GROUP_PAYMENT=payment-group
GROUP_NOTIFICATION=notification-group
GROUP_STOCK_VIEW=stock-view-group

# Consumer Configuration
AUTO_OFFSET_RESET=earliest
ENABLE_AUTO_COMMIT=false

# TV3: existing external PostgreSQL; TV4 never creates or queries this database.
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=

# TV4: Python directly on Windows. Fill in the separate account password locally.
STOCK_VIEW_DB_HOST=localhost
STOCK_VIEW_DB_PORT=5432
STOCK_VIEW_DB_NAME=stock_view_db
STOCK_VIEW_DB_USER=stock_view_user
STOCK_VIEW_DB_PASSWORD=

# Docker: use VM/host address or Compose service DNS, never localhost for another container.
DOCKER_STOCK_VIEW_DB_HOST=host.docker.internal
DOCKER_STOCK_VIEW_DB_PORT=5432
DOCKER_INVENTORY_DB_HOST=host.docker.internal
DOCKER_INVENTORY_DB_PORT=5432

# Optional docker-compose.local.yml only. New volume bootstrap uses a separate admin.
LOCAL_POSTGRES_ADMIN_PASSWORD=
LOCAL_STOCK_VIEW_DB_PORT=5433

# Payment simulation: random | success | failure. Keep identical on every instance/replay.
PAYMENT_MODE=random
PAYMENT_SUCCESS_RATE=0.9
PAYMENT_SEED=nt132
PAYMENT_DELIVERY_TIMEOUT=15

# Optional tests only: set in the PowerShell session to a dedicated *_test database.
# STOCK_VIEW_TEST_DSN=host=localhost port=5432 dbname=stock_view_test user=stock_view_test_user password=...
