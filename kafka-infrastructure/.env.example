# Image Apache Kafka. Giữ cố định tag này; không sử dụng `latest`.
KAFKA_IMAGE_TAG=4.1.1

# Địa chỉ và cổng VM1 công bố cho các client trên VM2.
# Đặt KAFKA_ADVERTISED_HOST thành IP tĩnh hoặc tên DNS của VM1 mà VM2 truy cập được.
KAFKA_ADVERTISED_HOST=192.168.56.10
KAFKA_PORT=9092

# Điểm cuối KRaft Controller; chỉ dùng trong mạng Docker của Kafka.
KAFKA_CONTROLLER_PORT=9093
KAFKA_NODE_ID=1

# Giữ nguyên giá trị này khi tái sử dụng kafka-data. Chỉ tạo giá trị mới
# trước lần khởi động đầu tiên của một volume Kafka mới, chưa có dữ liệu.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Tên volume lưu trữ bền vững và mạng bridge Docker.
KAFKA_DATA_VOLUME=kafka-data
KAFKA_DOCKER_NETWORK=nt132-kafka
